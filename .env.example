# LLM Provider: 'bedrock' or 'openai' (Default: bedrock)
LLM_PROVIDER=bedrock

# --- AWS Bedrock Configuration (When LLM_PROVIDER=bedrock) ---
BEDROCK_API_KEY=your_bedrock_api_key
BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
BEDROCK_FAST_MODEL=mistral.ministral-3-14b-instruct
BEDROCK_REASONING_MODEL=mistral.mistral-large-3-675b-instruct
BEDROCK_MODEL=mistral.mistral-large-3-675b-instruct

# --- OpenAI Configuration (When LLM_PROVIDER=openai) ---
OPENAI_API_KEY=your_openai_api_key
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_REASONING_MODEL=gpt-4o
OPENAI_MODEL=gpt-4o-mini

# --- Web Search Configuration ---
TAVILY_API_KEY=your_tavily_api_key_here

# --- General Agent Runtime ---
MAX_DEPTH=2
NODE_ENV=development
